# BFF configuration (environment variables). Real values live in .local/esm.env (git-ignored) or your secret store.
ESM_PUBLIC_ORIGIN=http://localhost:5174     # https:// in any real deployment; http is accepted for localhost only
ESM_HOST=127.0.0.1
ESM_PORT=5174
ESM_STATIC_DIR=./web/dist
OIDC_ISSUER=http://localhost:8180/realms/tricore
OIDC_CLIENT_ID=esm-bff
OIDC_CLIENT_SECRET=                          # confidential client secret: set it, never commit it
PLATFORM_API_URL=https://localhost:8443      # Platform ingress origin
NODE_EXTRA_CA_CERTS=./.local/caddy-root.crt  # only when the ingress uses a private CA
# ESM_COOKIE_SECURE=true                     # default: true when ESM_PUBLIC_ORIGIN is https
# ESM_SESSION_IDLE_SECONDS=1800
# ESM_SESSION_MAX_SECONDS=28800
